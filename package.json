{
  "name": "estoque-cirurgico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "tsx scripts/migrar.ts",
    "verificar": "npm run lint && npm run tipos && npm test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env teste",
    "cf:deploy:teste": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env teste",
    "cf:deploy:producao": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env producao",
    "usuario:admin": "tsx scripts/criar-admin.ts",
    "catalogo:carga": "tsx scripts/carga-catalogo.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=22"
  }
}
