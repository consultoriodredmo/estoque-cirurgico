// Configuração da Cloudflare (onde o sistema roda).
// DATABASE_URL, BETTER_AUTH_SECRET e BETTER_AUTH_URL NUNCA ficam aqui: são
// segredos enviados pelo workflow .github/workflows/publicar-teste.yml.
// Para fazer à mão: npx wrangler secret put NOME --env teste (ou --env producao).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "estoque-cirurgico",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "env": {
    "teste": {
      "name": "estoque-cirurgico-teste",
      "vars": { "APP_ENV": "teste" }
    },
    "producao": {
      "name": "estoque-cirurgico",
      "vars": { "APP_ENV": "producao" }
    }
  }
}
