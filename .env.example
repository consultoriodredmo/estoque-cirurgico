# Copie para .env e preencha. Nunca envie o .env para o repositório.

# Banco PostgreSQL. No Supabase, use a string do "Transaction pooler" (porta 6543).
DATABASE_URL=postgres://postgres@localhost:5432/estoque_dev

# "teste" (dados fictícios, faixa amarela) ou "producao" (dados reais).
APP_ENV=teste

# Chave secreta das sessões (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Endereço onde o sistema é acessado (sem barra no final).
BETTER_AUTH_URL=http://localhost:3000
